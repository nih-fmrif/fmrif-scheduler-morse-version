# Flask Settings
FLASK_APP=scheduler.app
FLASK_ENV=development

# App Settings
SERVER__SERVER_NAME=localhost:5051
CORE__SECRET_KEY=pleasechangeme
CORE__SITE_SENDER=noreply@example.com
CORE__LISTSERV=listserv@example.com
CORE__LOGIN_URL_PREFIX=https://auth.example.com/login
# CORE__NIH_NETWORKS=["127.0.0.1/32","::1/128","192.168.0.0/16"]

# Database Settings
DATABASE__HOST=localhost
DATABASE__PORT=5050
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres
DATABASE__DB=scheduler

# Mail Settings
MAIL__USERNAME=test
MAIL__PASSWORD=test

# LDAP Settings
# LDAP__HOST=ldap
# LDAP__PORT=389
# LDAP__USE_SSL=false
# LDAP__BIND_DN=cn=read-only-admin,dc=example,dc=com
# LDAP__BIND_PASSWORD=testbindpass
# LDAP__BASE_DN=dc=example,dc=com
