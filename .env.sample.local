# Flask Settings
FLASK_APP=scheduler.app:create_app
# FLASK_ENV=development
APP_ENV=development

# App Settings
APP_PORT=__APP_PORT__
# Keep blank unless you need stable URL construction in local flows.
SERVER__SERVER_NAME=__SERVER__SERVER_NAME__
# CORE__SECRET_KEY=pleasechangeme
# CORE__LISTSERV=listserv@example.com
# Optional local session defaults to avoid secure-cookie rejection on http://localhost.
SESSION__COOKIE_NAME=__SESSION__COOKIE_NAME__

# Database Settings
# PG* are used by the application and init scripts.
PGHOST=localhost
PGPORT=__PGPORT__
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=__PGDATABASE__
# Optional test database override for concurrent pytest runs.
SCHEDULER_TEST_DB_NAME=__SCHEDULER_TEST_DB_NAME__
# Optional compose isolation for multi-worktree local runs.
COMPOSE_PROJECT_NAME=__COMPOSE_PROJECT_NAME__

# For containerized postgres startup, run-compose.sh validates the file and launches compose
# with a generated interpolation file. The postgres wrapper reads PG* values from .env
# and forwards POSTGRES_* internally.

# Mail Settings
# MAIL__* is the app's Flask-Mail SMTP target.
# In host-mode local runs this should point to Mailpit via localhost + MAILPIT__SMTP_PORT.
# In compose-mode the scheduler container overrides MAIL__SERVER=mailpit and MAIL__PORT=1025.
MAIL__SERVER=localhost
MAIL__PORT=__MAILPIT__SMTP_PORT__
MAIL__SUPPRESS_SEND=false
# Required sender identity for emails emitted by Flask-Mail.
MAIL__DEFAULT_SENDER=__MAIL__DEFAULT_SENDER__
# MAIL__USERNAME=test
# MAIL__PASSWORD=test

# Mailpit Ports (for host-mode convenience and local stack access)
MAILPIT__PORT=__MAILPIT__PORT__
MAILPIT__SMTP_PORT=__MAILPIT__SMTP_PORT__

# Entra Settings
ENTRA__CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA__TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA__CLIENT_SECRET=your-client-secret-here
ENTRA__DISCOVERY_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0/.well-known/openid-configuration
ENTRA__REDIRECT_URI=https://scheduler.example.test/auth/callback
ENTRA__SCOPE=openid profile email offline_access
# Optional: additional accepted audiences for JWT validation
# ENTRA__ALLOWED_AUDIENCES=["api://00000000-0000-0000-0000-000000000000"]
# ENTRA__JWKS_CACHE_TTL=3600
# Optional bearer-token provisioning policy:
# Existing users are always allowed. New users are created only when enabled.
ENTRA__BEARER_AUTO_PROVISION_ENABLED=false
# Optional domain/group constraints when bearer auto-provisioning is enabled.
# ENTRA__BEARER_AUTO_PROVISION_DOMAINS=["nih.gov"]
# ENTRA__BEARER_AUTO_PROVISION_GROUPS=["group-id-1","group-id-2"]

# Test-only auth mocking (used by Playwright integration tests)
# setup-dotenv.sh replaces this placeholder with a random per-worktree secret.
AUTH_TEST__SHARED_SECRET=__GENERATE_AUTH_TEST_SECRET__
AUTH_TEST__SEED_GROUPS=DEV
PLAYWRIGHT_AUTH_MODE=mock
# Optional override: local port is auto-synced from APP_PORT in playwright.config.ts.
# Keep this unset for local defaults; set only for explicit remote targets.
# PLAYWRIGHT_BASE_URL=http://localhost:5051
# Optional: comma-separated group ids to ensure exist for mock auth sessions.
# Parsing is forgiving: invalid entries are ignored, and DEV is always ensured.
# AUTH_TEST__SEED_GROUPS=DEV,JOINTEST
# Optional custom profile mapping:
# AUTH_TEST__PROFILES={"dev":{"username":"ci-dev","email":"ci-dev@example.com","display_name":"CI Dev","active":true,"admin":false,"groups":["DEV"],"technologist":false,"test_scanner_tech":false}}

# Logging controls
# LOGGING__LEVEL=INFO
# LOGGING__REVEAL_SENSITIVE_DATA=false
# LOGGING__REDACTION_TEXT=[REDACTED]

# Security header controls
# SECURITY__ENABLE_CSP=true
# SECURITY__CSP_REPORT_ONLY=false
# SECURITY__CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'nonce-{nonce}'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
# Auth rate-limiting controls for local/dev workflows.
# Keep enabled; default here is moderate to still surface throttling defects.
# Increase temporarily (for example to 500) only for heavy parallel test runs.
# SECURITY__AUTH_RATE_LIMIT_ENABLED=true
# SECURITY__AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY__AUTH_RATE_LIMIT_MAX_REQUESTS=120

# OAuth Testing (for Playwright end-to-end tests)
# Only set these if you have valid test credentials for Microsoft Entra
# The Playwright test will skip gracefully if these are not provided
# Note: Username should NOT include @nih.gov suffix - the test adds it automatically
# OAUTH_TEST_USERNAME=test_user
# OAUTH_TEST_PASSWORD=replace-with-oauth-test-password
