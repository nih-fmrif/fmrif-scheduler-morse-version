# Flask Settings
FLASK_APP=scheduler.app
# FLASK_ENV=development

# App Settings
SERVER__SERVER_NAME=localhost:5051
# CORE__SECRET_KEY=pleasechangeme
# CORE__SITE_SENDER=noreply@example.com
# CORE__LISTSERV=listserv@example.com
# CORE__NIH_NETWORKS=["127.0.0.1/32","::1/128","192.168.0.0/16"]

# Database Settings
PGHOST=localhost
PGPORT=5444
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=fmrif_scheduler

# Mail Settings
# MAIL__USERNAME=test
# MAIL__PASSWORD=test

# LDAP Settings
LDAP__HOST=NIHIAMANON2.nih.gov
LDAP__PORT=5636
LDAP__USE_SSL=true
LDAP__BASE_DN=OU=Users,DC=nih,DC=gov
LDAP__USER_SEARCH_FILTER=(samaccountname={username})
LDAP__USER_ID_ATTRIBUTE=sAMAccountName
LDAP__USER_OBJECT_CLASS=user

# SSL/TLS Settings
LDAP__TLS_REQCERT=never
LDAP__TLS_CACERTDIR=/etc/openldap/cacerts

# NIH LDAP Behavior
LDAP__FORCE_UPPER_CASE_REALM=true
LDAP__ID_MAPPING=false
LDAP__REFERRALS=false

# Backup LDAP Servers
LDAP__BACKUP_HOSTS=["NIHIAMANON1.nih.gov", "NIHIAMANON3.nih.gov", "NIHIAMANON4.nih.gov"]

# Required User Attributes (simplified for authentication only)
LDAP__REQUIRED_USER_ATTRS=["mail", "department"]

# RBAC Settings
RBAC__SUPERUSER_MODE=true
RBAC__USER_DEPARTMENTS='{"NIMH": {"RESEARCH": true, "ADMIN": false}, "NINDS": {"CLINICAL": true}}'
# RBAC__DEVICE_DEPARTMENTS={"SCANNER1": ["RESEARCH", "CLINICAL"], "SCANNER2": ["ADMIN"]}
# RBAC__DEVICE_PERMISSIONS={"researcher1": {"SCANNER1": {"templates": true, "slot": true, "tech": true, "medical": false, "training": true}}, "researcher2": {"SCANNER2": {"templates": false, "slot": true, "tech": false, "medical": false, "training": true}}}
