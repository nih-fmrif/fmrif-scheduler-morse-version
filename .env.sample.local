# Flask Settings
FLASK_APP=scheduler.app
# FLASK_ENV=development

# App Settings
SERVER__SERVER_NAME=localhost:5051
# CORE__SECRET_KEY=pleasechangeme
# CORE__SITE_SENDER=noreply@example.com
# CORE__LISTSERV=listserv@example.com
# CORE__NIH_NETWORKS=["127.0.0.1/32","::1/128","192.168.0.0/16"]

# Database Settings
PGHOST=localhost
PGPORT=5444
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=fmrif_scheduler

# Mail Settings
# MAIL__USERNAME=test
# MAIL__PASSWORD=test

# Entra Settings
ENTRA__CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA__TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA__DISCOVERY_URL=https://login.microsoftonline.com/${ENTRA__TENANT_ID}/v2.0/.well-known/openid-configuration
ENTRA__REDIRECT_URI=https://fmrif-schedule-backend-staging.nimh.nih.gov
# Optional: additional accepted audiences for JWT validation
# ENTRA__ALLOWED_AUDIENCES=["api://00000000-0000-0000-0000-000000000000"]
# ENTRA__JWKS_CACHE_TTL=3600

# RBAC Settings
RBAC__SUPERUSER_MODE=true
RBAC__USER_DEPARTMENTS='{"NIMH": {"RESEARCH": true, "ADMIN": false}, "NINDS": {"CLINICAL": true}}'
# RBAC__DEVICE_DEPARTMENTS={"SCANNER1": ["RESEARCH", "CLINICAL"], "SCANNER2": ["ADMIN"]}
# RBAC__DEVICE_PERMISSIONS={"researcher1": {"SCANNER1": {"templates": true, "slot": true, "tech": true, "medical": false, "training": true}}, "researcher2": {"SCANNER2": {"templates": false, "slot": true, "tech": false, "medical": false, "training": true}}}

# OAuth Testing (for Playwright end-to-end tests)
# Only set these if you have valid test credentials for Microsoft Entra
# The Playwright test will skip gracefully if these are not provided
# Note: Username should NOT include @nih.gov suffix - the test adds it automatically
# OAUTH_TEST_USERNAME=test_user
# OAUTH_TEST_PASSWORD=test_password
