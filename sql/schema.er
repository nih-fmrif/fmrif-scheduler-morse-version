title {
	label: "Scheduler ER diagram (legacy shaded)",
	font: "Helvetica",
}
entity {
	font: "Helvetica",
	border: "3",
}
relationship {
	font: "Helvetica",
	size: "25",
	color: "#444444",
}

# deprecated tables, deprecated columns, and log tables are omitted for clarity

# shade legacy tables

[tblsched] {bgcolor: "#ececfc"}
*schedid
+scannercode
scheddate
scheddow
schedhour
+deptcode
+researchercode
time_used
chg_at
chg_by
+templateid
+orig_deptcode
+orig_instcode

tblsched 1--* tlkpscanner
tblsched ?--* tlkpdept
tblsched ?--* tlkpresearcher
tblsched 1--* tbltemplate
# use labels only when key names don't match
tblsched ?--* tlkpdept { label: "orig_deptcode" }
tblsched ?--* tlkpinst { label: "orig_instcode" }


[tbltemplate] {bgcolor: "#ececfc"}
*templateid
+scannercode
dow
hour
+deptcode
+researchercode
+templatecode
+instcode

tbltemplate 1--* tlkpscanner
tbltemplate ?--* tlkpdept
tbltemplate 1--* tlkpresearcher
tbltemplate ?--* tlkpinst
tbltemplate 1--* tbltemplates

[tbltemplates] {bgcolor: "#ececfc"}
*templatecode
*+scannercode
+template
comments
hidden

tbltemplates 1--* tlkpscanner

[tlkpdept] {bgcolor: "#ececfc"}
*deptcode
dept
dept_short
ismain
iscurrent
+inst
link
email
color {bgcolor: "#ffffff"}
joinable {bgcolor: "#ffffff"}
archivable {bgcolor: "#ffffff"}
schedulable {bgcolor: "#ffffff"}
department {bgcolor: "#ffffff"}

tlkpdept ?--* tlkpinst

[tlkpinst] {bgcolor: "#ececfc"}
*instcode
inst
hidden {bgcolor: "#ffffff"}

[tlkpresearcher] {bgcolor: "#ececfc"}
*researchercode
chg_at
active
name {bgcolor: "#ffffff"}
email  {bgcolor: "#ffffff"}

[tlkpscanner] {bgcolor: "#ececfc"}
*scannercode
scanner
descrip
mailinglist
active

[groupmembers]
*+deptcode
*+researchercode
approve1
approve2
approved

groupmembers *--? tlkpdept
groupmembers *--? tlkpresearcher

[primarygroupmember]
*+deptcode
*+researchercode

primarygroupmember *--1 groupmembers