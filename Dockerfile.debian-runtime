ARG DEBIAN_VERSION=12.13
FROM debian:${DEBIAN_VERSION}

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    IS_CONTAINER=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/var/lib/fmrif-scheduler

RUN apt-get update \
    && packages=( \
        bash \
        ca-certificates \
        curl \
        postgresql-client \
        python3 \
        python3-alembic \
        python3-blinker \
        python3-cachelib \
        python3-click \
        python3-cryptography \
        python3-dotenv \
        python3-email-validator \
        python3-flask \
        python3-flask-mail \
        python3-flask-session \
        python3-flask-sqlalchemy \
        python3-flaskext.wtf \
        python3-greenlet \
        python3-gunicorn \
        python3-itsdangerous \
        python3-jinja2 \
        python3-jwt \
        python3-markupsafe \
        python3-psycopg2 \
        python3-requests \
        python3-sqlalchemy \
        python3-werkzeug \
        python3-wtforms \
    ) \
    && if apt-cache show python3-msgspec >/dev/null 2>&1; then \
        packages+=(python3-msgspec); \
    fi \
    && apt-get install -y --no-install-recommends "${packages[@]}" \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system fmrif-scheduler \
    && useradd \
        --system \
        --create-home \
        --home-dir /var/lib/fmrif-scheduler \
        --shell /usr/sbin/nologin \
        --gid fmrif-scheduler \
        fmrif-scheduler \
    && mkdir -p /app /var/log/fmrif-scheduler \
    && chown -R fmrif-scheduler:fmrif-scheduler \
        /var/lib/fmrif-scheduler \
        /var/log/fmrif-scheduler

WORKDIR /app

COPY alembic.ini /app/alembic.ini
COPY entrypoint.sh /app/entrypoint.sh
COPY scheduler /app/scheduler
COPY sql /sql

RUN chmod 0755 /app/entrypoint.sh /sql/000-init.sh \
    && find /app -type d -exec chmod 0755 {} + \
    && find /app -type f -exec chmod 0644 {} + \
    && chmod 0755 /app/entrypoint.sh /sql/000-init.sh

USER fmrif-scheduler:fmrif-scheduler

ENTRYPOINT ["/app/entrypoint.sh"]
