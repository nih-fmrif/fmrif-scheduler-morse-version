[Unit]
Description=FMRIF Scheduler Flask Application
After=network.target postgresql.service

[Service]
Type=simple
User=leejo
WorkingDirectory=/home/leejo/fmrif-scheduler-morse-version
Environment="PATH=/home/leejo/fmrif-scheduler-morse-version/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="FLASK_APP=scheduler.app:create_app"
ExecStart=/bin/bash /home/leejo/fmrif-scheduler-morse-version/scripts/serve.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
